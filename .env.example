# Copy to .env and fill in. Never commit .env.

# CENTER ONLY (never given to an app): 32+ random characters, signs center-internal tokens (refresh, mfa, fresh,
# passkey challenges). e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Superuser password; only the postgres service gets it. Services connect as their own roles (below).
POSTGRES_PASSWORD=
# One password per service database role (sn_center, sn_chat, ...). Use HEX so it is safe inside DATABASE_URL:
#   python -c "import secrets; print(secrets.token_hex(24))"
# After editing these on an existing volume, run shared/infra/postgres/apply-roles.sh (see README).
DB_PASSWORD_CENTER=
DB_PASSWORD_CHAT=
DB_PASSWORD_PHOTOS=
DB_PASSWORD_WATCH=
DB_PASSWORD_WEREWOLF=
DB_PASSWORD_MARKET=
DB_PASSWORD_LEARNING=
DB_PASSWORD_JOBS=
# Optional key id for the access-token signing key (default: thumbprint of the public key). Apps look keys up by
# this id; with a custom id write "kid: <id>" on the line above that key in secrets/jwt_public_keys.pem.
JWT_KEY_ID=
# The Ed25519 access-token keys are FILES, not variables: shared/infra/secrets/jwt_private.pem (center only) and
# shared/infra/secrets/jwt_public_keys.pem (every app). Create them with:
#   cd center/backend && python -m app.cli gen-jwt-key        (see README "Access-token keys")
# Password of the internal redis service (shared throttles and single-use passkey challenges between
# center replicas). Use hex so it is safe inside REDIS_URL:  python -c "import secrets; print(secrets.token_hex(24))"
REDIS_PASSWORD=

# Set to 1 when the gateway is served over HTTPS (marks the auth cookie Secure).
COOKIE_SECURE=0
# Origin browsers use to reach the gateway (WebSocket Origin check).
PUBLIC_ORIGIN=http://localhost:8080
GATEWAY_PORT=8080

# --- Sign-in options (all optional) ---
# development | production. Production requires COOKIE_SECURE=1 and turns off /docs.
APP_ENV=development
# Access cookie lifetime and refresh-cookie lifetime.
ACCESS_TOKEN_MINUTES=60
REFRESH_DAYS=14
# Google sign-in: create an OAuth Web client at https://console.cloud.google.com/apis/credentials,
# add http://localhost:8080 (and your real origin) to "Authorised JavaScript origins", paste the client id here.
GOOGLE_CLIENT_ID=
# Face + voice sign-in (heavy: torch, dlib, opencv, ffmpeg). To use it set BOTH of these to 1 and
# rebuild the image (`docker compose ... build center-backend`, several minutes, ~2-3 GB):
WITH_BIOMETRICS=0
BIOMETRICS_ENABLED=0
# Fernet key that encrypts the stored face/voice templates. Keep it secret and do not lose it.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_KEY=
# Passkeys (WebAuthn). The relying-party id is the bare hostname users see (no scheme, no port); when
# empty it is taken from PUBLIC_ORIGIN (localhost in development). Passkeys are bound to this id: changing
# it later makes every registered passkey unusable. The origin that must match is PUBLIC_ORIGIN.
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=Mạng xã hội

# --- Email (verification, magic link / code sign-in, password reset, security notices) ---
# Development: COMPOSE_PROFILES=mail-dev starts "mailpit", a mail sink with an inbox at http://localhost:8025.
# Production: remove that profile and point SMTP_* at a real server (SMTP_STARTTLS=1 for port 587).
COMPOSE_PROFILES=mail-dev
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Mạng xã hội <no-reply@localhost>
SMTP_STARTTLS=0
# Implicit TLS (port 465): set SMTP_SSL=1 and SMTP_PORT=465 instead of SMTP_STARTTLS. Never both.
SMTP_SSL=0
# Only for a trusted network: allow SMTP_USER/SMTP_PASSWORD without TLS to a non-local host.
SMTP_ALLOW_PLAINTEXT_AUTH=0
#
# Real mail example (Gmail needs an app password: https://myaccount.google.com/apppasswords):
#   (remove COMPOSE_PROFILES=mail-dev above)
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASSWORD=<16-character app password>
#   SMTP_FROM=Mạng xã hội <you@gmail.com>
#   SMTP_STARTTLS=1

# --- Phone / SMS one-time code sign-in (empty SMS_PROVIDER = feature hidden) ---
# 'mailbox' (DEV ONLY, refused when APP_ENV=production): the SMS text is mailed to <digits>@sms.local (see Mailpit).
# 'twilio': set TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN / TWILIO_FROM.
SMS_PROVIDER=
SMS_DAILY_CAP=500
SMS_ALLOWED_PREFIXES=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
