# Copy to .env and fill in. Never commit .env.

# 32+ random characters, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
POSTGRES_PASSWORD=

# Set to 1 when the gateway is served over HTTPS (marks the auth cookie Secure).
COOKIE_SECURE=0
# Origin browsers use to reach the gateway (WebSocket Origin check).
PUBLIC_ORIGIN=http://localhost:8080
GATEWAY_PORT=8080
